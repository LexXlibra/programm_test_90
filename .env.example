# Local Compose defaults work as written. Replace secrets before any shared deployment.
APP_URL=http://localhost
APP_DOMAIN=localhost
DATABASE_URL=postgresql://nynety:nynety_local_only@localhost:5432/nynety?schema=public
BETTER_AUTH_URL=http://localhost
STORAGE_PATH=./storage/releases
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PORT=5432
POSTGRES_PASSWORD=nynety_local_only
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
MAX_AUDIO_FILE_SIZE_MB=250
MAX_ARTWORK_FILE_SIZE_MB=20
LOG_LEVEL=info
